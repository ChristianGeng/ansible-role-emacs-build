# Rendered by the emacs-build ansible role.  Do not edit by hand.
#
# Toolchain image only: the same distribution release as the host plus the
# Emacs build dependencies and a current tree-sitter.  The compile itself
# runs later in a container from this image with the work dir and the
# install prefix bind-mounted from the host, so sources and object files
# never touch Docker's disk (see files/build-in-container.sh).
FROM {{ emacs_base_image }}

ARG DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential gcc-{{ emacs_gcc_version }} g++-{{ emacs_gcc_version }} \
        libgccjit0 libgccjit-{{ emacs_gcc_version }}-dev \
        autoconf automake texinfo pkg-config git curl ca-certificates xz-utils \
        libgnutls28-dev libxml2-dev libncurses-dev libsqlite3-dev libgmp-dev zlib1g-dev \
        libgtk-3-dev libcairo2-dev libharfbuzz-dev libfreetype-dev libfontconfig-dev \
        libx11-dev libxext-dev libxi-dev libxrandr-dev libxinerama-dev libxfixes-dev \
        libxpm-dev libxt-dev libxaw7-dev \
        libjpeg-dev libpng-dev libgif-dev libtiff-dev libwebp-dev librsvg2-dev \
        libdbus-1-dev libacl1-dev libselinux1-dev libsystemd-dev libgpm-dev \
        libasound2-dev liblcms2-dev \
    && rm -rf /var/lib/apt/lists/*

# tree-sitter from source: the distribution package is too old for Emacs 30.
RUN git clone --depth 1 --branch v{{ tree_sitter_version }} \
        https://github.com/tree-sitter/tree-sitter /opt/tree-sitter \
    && make -C /opt/tree-sitter -j{{ emacs_jobs }} PREFIX=/usr/local install \
    && ldconfig \
    && rm -rf /opt/tree-sitter

ENV CC=gcc-{{ emacs_gcc_version }} \
    PKG_CONFIG_PATH=/usr/local/lib/pkgconfig
